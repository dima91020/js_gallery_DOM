"use strict";
var galleryList = document.querySelector(".gallery__list");
var mainImage = document.querySelector(".gallery__large-img");
// eslint-disable-next-line
galleryList.addEventListener("click", function(event) {
    event.preventDefault();
    var listItemLink = event.target.closest(".list-item__link");
    if (!listItemLink) return;
    mainImage.src = listItemLink.href;
});

